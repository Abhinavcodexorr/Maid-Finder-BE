# Server
PORT=3002
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/maid-finder

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:3000

# AWS S3 (for image uploads)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# Admin API (shared secret required by all /api/v1/admin/* routes — send as the
# x-admin-key header; must match the admin dashboard's ADMIN_API_KEY)
ADMIN_API_KEY=change-this-admin-key
